{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://multibank-automated-trading-nse.vercel.app/api/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ]
}
